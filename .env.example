# Copy to .env and fill in before `docker compose up -d`.

# Auth
JWT_SECRET=change-me-to-a-random-string

# OAuth token envelope encryption — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# LiteLLM / OpenRouter (BRD §20) — optional, only needed for the built-in AI copilot
OPENROUTER_API_KEY=
LITELLM_MASTER_KEY=sk-litellm-dev

# Public origin the browser uses to reach this deployment — must match what
# you actually access it at, since it's used to build the Google OAuth
# redirect URI below.
APP_BASE_URL=http://localhost:3000

# Google Calendar OAuth (BR-CAL-001). Create a Web application OAuth client
# at console.cloud.google.com (APIs & Services > Credentials), with an
# Authorized redirect URI of exactly:
#   ${APP_BASE_URL}/api/v1/admin/accounts/google/callback
# e.g. http://localhost:3000/api/v1/admin/accounts/google/callback for local dev.
# Also enable the "Google Calendar API" under APIs & Services > Library.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft Graph OAuth (BR-CAL-002) — not yet wired into a connector implementation
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
