# Copy to .env and fill in before `docker compose up -d`.

# Auth
JWT_SECRET=change-me-to-a-random-string

# OAuth token envelope encryption — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# LiteLLM / OpenRouter (BRD §20) — optional, only needed for the built-in AI copilot
OPENROUTER_API_KEY=
LITELLM_MASTER_KEY=sk-litellm-dev

# Google Calendar OAuth (BR-CAL-001) — not yet wired into a connector implementation
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft Graph OAuth (BR-CAL-002) — not yet wired into a connector implementation
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
