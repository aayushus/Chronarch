# Copy to .env and fill in before `docker compose up -d`.

# Auth — REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Compose fails fast if this is missing. For throwaway local dev only you may
# set ALLOW_INSECURE_DEV_SECRET=1 instead (never in production).
JWT_SECRET=
# ALLOW_INSECURE_DEV_SECRET=1

# Postgres — REQUIRED password (user/db default to chronarch for local dev).
POSTGRES_USER=chronarch
POSTGRES_PASSWORD=
POSTGRES_DB=chronarch

# OAuth token envelope encryption — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# LiteLLM / OpenRouter (BRD §20) — optional, only needed for the built-in AI copilot
OPENROUTER_API_KEY=
LITELLM_MASTER_KEY=sk-litellm-dev

# Public origin the browser uses to reach this deployment — must match what
# you actually access it at, since it's used to build the Google OAuth
# redirect URI below.
APP_BASE_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API/MCP. Defaults to
# APP_BASE_URL (single-origin). Set explicitly in production, e.g.
# CORS_ORIGINS=https://calendar.example.com. Use "*" only for throwaway
# local testing (credentials are then never sent).
# CORS_ORIGINS=

# Google Calendar OAuth (BR-CAL-001) — OPTIONAL here. Preferred: set the
# client ID/secret from the UI under Settings > Accounts > Provider
# credentials (stored encrypted in the DB; DB wins when set). These env vars
# remain as fallback for env-only deploys.
# Create a Web application OAuth client at console.cloud.google.com
# (APIs & Services > Credentials), with an Authorized redirect URI of exactly:
#   ${APP_BASE_URL}/api/v1/admin/accounts/google/callback
# e.g. http://localhost:3000/api/v1/admin/accounts/google/callback for local dev.
# Also enable the "Google Calendar API" under APIs & Services > Library.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft Graph OAuth (BR-CAL-002) — not yet wired into a connector implementation
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Rate Limiting (optional overrides)
# LOGIN_RATE_LIMIT_REQUESTS=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# PASSWORD_RATE_LIMIT_REQUESTS=5
# PASSWORD_RATE_LIMIT_WINDOW_SECONDS=60

